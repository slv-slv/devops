PORT=3000

# В пользовательской сети todo-net работает разрешение имен контейнеров через DNS, поэтому можно обращаться без использования IP-адреса
DB_HOST=todo-db-container
DB_PORT=5432
DB_USER=todo
DB_PASSWORD=todo
DB_NAME=todo

# Фронт снаружи открыт на порту 18080, поэтому в заголовке Origin на бэк придет именно http://localhost:18080
CORS_ORIGIN=http://localhost:18080
